# Microservice Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn[standard]==0.27.0 \
    pydantic==2.5.3 \
    email-validator==2.1.0

# Copy service code
COPY . .

# Expose port (will be overridden in docker-compose)
EXPOSE 8000

# Run the application
CMD ["python", "main.py"]
